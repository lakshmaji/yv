# Wails build output. Only the compiled artifacts — build/ also holds real
# source: the app icon, the macOS Info.plist templates, and the Linux desktop
# entry and packaging script, all of which a fresh clone needs to build.
build/bin/

# Wails dev mode generated files
wailsjs/
frontend/wailsjs/

# Go
*.exe
*.test
*.out
/vendor/

# macOS
.DS_Store
*.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Frontend. bun.lock is deliberately *not* ignored — CI installs with
# `bun install --frozen-lockfile`, which needs it committed. package-lock.json is,
# so that a stray `npm install` can't land a second lockfile beside it.
frontend/node_modules/
frontend/dist/
frontend/package-lock.json
frontend/package.json.md5

# Local sound clips. No audio ships with the app — users add their own in
# Settings, so these are samples for development only.
assets/

# Binary
yv
yv.exe
yv.dmg
