// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  // `scripts` is excluded because it runs under Bun, not in the site build, and
  // reaches into the Wails frontend's sources — neither of which this config
  // describes. The tests are excluded for the first of those reasons alone:
  // they import `bun:test`, whose types are not part of this project.
  "exclude": [".docusaurus", "build", "scripts", "src/**/*.test.ts"]
}
